#pragma once
/* secrets.h — cp this to secrets.h and fill in. secrets.h is gitignored.
 *
 * ⚠ WiFi EXISTS ON THIS DEVICE FOR EXACTLY ONE REASON: OTA REFLASHING.
 *   The game is pure arithmetic and reads the network on no code path. There is
 *   no relay, no API token, no server, no telemetry. If a future change makes
 *   the gameplay depend on WiFi, that is a different device — say so out loud.
 *
 *   Why keep it at all: OTA is a one-way door — flashing a sketch WITHOUT
 *   ArduinoOTA over the air makes the board un-reflashable without a cable, and
 *   the board may well end up somewhere awkward to reach.
 */
#define WIFI_SSID  "your-ssid"
#define WIFI_PASS  "your-password"

/* ⚠ THIS BOARD'S OWN OTA PASSWORD — never reuse another device's. */
#define OTA_PASS   "pick-something-unique"
