#pragma once
/* secrets.h — cp this to secrets.h and fill in. secrets.h is gitignored.
 *
 * ⚠ WiFi IS FOR OTA REFLASHING, AND FOR ONE MESSAGE PER BOOT.
 *   The game is pure arithmetic and reads the network on no code path — it
 *   plays identically with every access point down. If a future change makes
 *   GAMEPLAY depend on WiFi, that is a different device — say so out loud.
 *
 *   ⚠ THIS FILE USED TO SAY "no relay, no API token, no server, no telemetry",
 *   AND SINCE 2026-08-03 THAT IS NO LONGER TRUE. Corrected here rather than
 *   quietly left standing, because the sentence it replaces instructed whoever
 *   changed it to announce exactly this.
 *
 *   The board POSTs once per boot to api.pense-bem-wars.com: a random UUID it
 *   generated on itself, plus the firmware build stamp. Not the MAC address,
 *   not a score, not an answer, not a book. It exists so the project's author
 *   can count boards actually built instead of guessing. It is disclosed on
 *   screen at first boot in Portuguese and English, documented in the README,
 *   and `#define PB_PHONE_HOME 0` in the sketch compiles the whole thing out —
 *   hostname, disclosure text and all, verifiably absent from the image.
 *
 *   Why keep WiFi at all: OTA is a one-way door — flashing a sketch WITHOUT
 *   ArduinoOTA over the air makes the board un-reflashable without a cable, and
 *   the board may well end up somewhere awkward to reach.
 */

/* ⚠ THE FALLBACK, NOT THE PRIMARY. The sketch tries the shared "pense-bem"
 *   hotspot first (PB_HOTSPOT_SSID in the .ino) and only then this network, so
 *   a board can travel without being reflashed. Both are optional: with neither
 *   reachable the game is unaffected and nothing is sent. */
#define WIFI_SSID  "your-ssid"
#define WIFI_PASS  "your-password"

/* ⚠ THIS BOARD'S OWN OTA PASSWORD — never reuse another device's. */
#define OTA_PASS   "pick-something-unique"
