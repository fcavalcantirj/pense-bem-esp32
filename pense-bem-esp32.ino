static const Note SFX_SPLASH_B[] = { {659, 90} };
static const Note SFX_SPLASH_C[] = { {784, 90} };
static const Note SFX_SPLASH_D[] = { {1047, 220} };
// The four end-of-session songs, one per score band — the toy really had four.
