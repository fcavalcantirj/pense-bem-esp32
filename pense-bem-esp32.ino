// Repaint only when something actually changed — a full 240x135 push is not free.
static void render()
{
    char sig[128];
    snprintf(sig, sizeof(sig), "%d|%d%d%d|%d|%d|%d|%d|%d|%d|%d|%d",
             (int)screen, digits[0], digits[1], digits[2], pos, answerSel,
             game.index, game.attempt, game.raw, (int)lastVerdict,
             lastScore, muted ? 1 : 0);
    if (lastDrawn == sig) { return; }
    lastDrawn = sig;

    switch (screen) {
    case SC_STANDBY:  drawStandby();  break;
    case SC_CODE:     drawCode();     break;
    case SC_BAD:      drawBad();      break;
    case SC_QUESTION: drawQuestion(); break;
    case SC_JUDGE:    drawJudge();    break;
    case SC_SCORE:    drawScore();    break;
    }
}

static void go(Screen s)
{
    screen = s;
    screenAt = millis();
    lastDrawn = "";
}

// ---- actions ---------------------------------------------------------------

static void startCode()
{
    digits[0] = digits[1] = 0;
    digits[2] = 0;                 // VALS[2] is "123456<", so index 0 is section 1
    pos = 0;
    go(SC_CODE);
}

static void commitCode()
{
    char v = valAt(pos, digits[pos]);

    if (v == '<') {                        // ERASE is a value, never a long press
        if (pos == 0) { go(SC_STANDBY); }
        else          { pos--; go(SC_CODE); }
        PLAY(SFX_STEP);
        return;
    }
    if (pos < 2) { pos++; go(SC_CODE); PLAY(SFX_OK); return; }

    {
        int book = (valAt(0, digits[0]) - '0') * 10 + (valAt(1, digits[1]) - '0');
        int section = valAt(2, digits[2]) - '0';

        if (book < 1) {
            badReason = "livro 00 nao existe";
            PLAY(SFX_BAD); go(SC_BAD); return;
        }
        // ⚠ Seeded from micros() at the confirm press. esp_random() is only a true
        //   RNG while RF is active, and this game must be correct with WiFi down;
        //   a human's press timing is real entropy and costs one line.
        if (!pb_game_start(&game, book, section, (unsigned long long)micros())) {
            badReason = "codigo invalido";
            PLAY(SFX_BAD); go(SC_BAD); return;
        }
        answerSel = 0;
        PLAY(SFX_OK);
        go(SC_QUESTION);
    }
}

static void submitAnswer()
{
    lastVerdict = pb_game_answer(&game, (char)('A' + answerSel));

    // ⚠ PB_IGNORED changes nothing and must never look like a wrong answer.
    if (lastVerdict == PB_IGNORED) { return; }

    if (lastVerdict == PB_RIGHT)      { PLAY(SFX_RIGHT);  }
    else if (lastVerdict == PB_RETRY) { PLAY(SFX_WRONG);  }
    else                              { PLAY(SFX_REVEAL); }

    answerSel = 0;
    go(SC_JUDGE);
}

static void afterJudge()
{
    if (game.done) {
        lastScore = game.raw;
        lastBook = game.book;
        lastSection = game.section;
        prefs.putInt("score", lastScore);
        prefs.putInt("book", lastBook);
        prefs.putInt("sec", lastSection);
        switch (pb_game_band(&game)) {
        case 0: PLAY(SONG_0); break;
        case 1: PLAY(SONG_1); break;
        case 2: PLAY(SONG_2); break;
        default: PLAY(SONG_3); break;
        }
        go(SC_SCORE);
    } else {
        go(SC_QUESTION);
    }
}

static void onSelect()
{
    lastInput = millis();
    switch (screen) {
    case SC_CODE:
        digits[pos] = (digits[pos] + 1) % valCount(pos);
        PLAY(SFX_STEP);
        break;
    case SC_QUESTION:
        answerSel = (answerSel + 1) % 4;
        PLAY(SFX_STEP);
        break;
    default:
        break;
    }
}

static void onOk()
{
    lastInput = millis();
    switch (screen) {
    case SC_STANDBY:  PLAY(SFX_OK); startCode();  break;
    case SC_CODE:     commitCode();               break;
    case SC_QUESTION: submitAnswer();             break;
    case SC_SCORE:    PLAY(SFX_OK); go(SC_STANDBY); break;
    default:          break;   // SC_BAD and SC_JUDGE time out on their own
    }
}

// ---- input -----------------------------------------------------------------

static void inputTick()
{
    static bool okDown = false, selDown = false;
    static uint32_t okAt = 0, selAt = 0, nextRepeat = 0;

    uint32_t now = millis();
    bool ok  = (digitalRead(PIN_OK)     == LOW);
    bool sel = (digitalRead(PIN_SELECT) == LOW);

    // OK: fires on RELEASE, after a debounce. No hold gesture — GPIO0 is a
    // strapping pin and the sibling board's watchdog scar lives on holding it.
    if (ok && !okDown) { okDown = true; okAt = now; }
    else if (!ok && okDown) {
        okDown = false;
        if (now - okAt >= DEBOUNCE_MS) { onOk(); }
    }

    // SELECT: fires on PRESS, then auto-repeats while held (accelerating).
    // That is what makes 0-9 entry painless with a single button.
    if (sel && !selDown) {
        selDown = true; selAt = now;
        onSelect();
        nextRepeat = now + REPEAT_WAIT_MS;
    } else if (sel && selDown) {
        if (now >= nextRepeat) {
            // A long hold on STANDBY toggles mute instead of repeating.
            if (screen == SC_STANDBY) {
                muted = !muted;
                prefs.putBool("muted", muted);
                if (!muted) { PLAY(SFX_OK); }
                lastDrawn = "";
                nextRepeat = now + 1000;
            } else {
                onSelect();
                nextRepeat = now + ((now - selAt > REPEAT_ACCEL_MS) ? REPEAT_TURBO_MS
                                                                   : REPEAT_FAST_MS);
            }
        }
    } else if (!sel && selDown) {
        selDown = false;
    }
}

// ---- timers ----------------------------------------------------------------

static void timerTick()
{
    uint32_t now = millis();

    if (screen == SC_JUDGE) {
        uint32_t hold = (lastVerdict == PB_REVEAL) ? REVEAL_HOLD_MS : JUDGE_HOLD_MS;
        if (now - screenAt >= hold) { afterJudge(); }
        return;
    }
    if (screen == SC_BAD && now - screenAt >= BAD_HOLD_MS) { startCode(); return; }

    // ⚠ The game screen gets 10 minutes, the menus 3. See the constants block.
    uint32_t limit = (screen == SC_QUESTION) ? IDLE_GAME_MS : IDLE_MENU_MS;
    if (screen != SC_STANDBY && now - lastInput >= limit) { go(SC_STANDBY); }
}

// ---- setup / loop ----------------------------------------------------------

/* ── network selection, non-blocking ───────────────────────────────────────
   Alternates between the shared hotspot and the secrets.h network until one
   answers, then stops trying. Never scans, never waits, never blocks a frame.
   The hotspot goes first so a board carried somewhere else prefers the network
   that travels with it. */
/* ⚠⚠ THIS ALTERNATES ONCE, THEN STOPS. IT USED TO FLIP FOREVER, AND THAT TOOK A
   REAL BOARD OFF THE NETWORK.
   The first version swapped networks every 15 s for as long as it was
   disconnected. Association plus DHCP on a busy 2.4 GHz band routinely takes
   longer than that, so every swap ABORTED a connection that was still being
   negotiated — a board could flip between two APs indefinitely and never land on
   either. It looks harmless in the diff (a timer and an XOR) and it cost OTA
   access to a board sitting on someone's desk, recoverable only over USB.

   So: try the hotspot once, fall back to secrets.h once, then STOP TRYING and
   leave the radio alone. WiFi.setAutoReconnect(true) owns it from there, which
   is the code path the ESP-IDF actually tests. A board that lands on neither
   network plays the game exactly as well — that is the whole point of the
   design — and picks a network up on its next power cycle.

   ⚠ The lesson generalises past WiFi: RETRYING A SLOW OPERATION ON A TIMER
   SHORTER THAN THE OPERATION TAKES IS NOT A RETRY, IT IS A GUARANTEE OF
   FAILURE, and it is invisible in review because every individual line is
   reasonable. */
static uint8_t  wifiStage   = 0;   /* 0 = hotspot, 1 = secrets.h, 2 = done trying */
static uint32_t wifiTriedAt = 0;

static void wifiBeginStage()
{
    wifiTriedAt = millis();

    /* ⚠⚠ THE disconnect() IS LOAD-BEARING, AND ITS ABSENCE FAILED SILENTLY.
       The ESP-IDF REFUSES a credential change while the station is still
       associating, and it says so only on the serial console:

           E (43770) wifi:sta is connecting, cannot set config

       WiFi.begin() returns and the sketch carries on believing it switched
       networks. It did not. The board stayed on the first SSID — a hotspot that
       does not exist here — and no amount of retrying could ever move it,
       because every retry was refused by the same rule.

       Nothing above the serial line can see this: begin() has no useful return,
       the build is green, the binary is correct, and WiFi.status() reports
       DISCONNECTED either way, which is exactly what you would expect from a
       network that is genuinely out of range. It cost a board's OTA access and
       was found only by plugging in a USB cable and reading the log. */
    WiFi.disconnect(false, false);   /* release the station so config can be set */

    if (wifiStage == 0) WiFi.begin(PB_HOTSPOT_SSID, PB_HOTSPOT_PASS);
    else                WiFi.begin(WIFI_SSID, WIFI_PASS);
    Serial.printf("wifi: trying %s\n",
                  wifiStage == 0 ? PB_HOTSPOT_SSID : WIFI_SSID);
}

static void wifiTick()
{
    if (wifiStage >= 2) return;                       /* handed to autoreconnect */
    if (WiFi.status() == WL_CONNECTED) { wifiStage = 2; return; }
    if (millis() - wifiTriedAt < PB_WIFI_SWAP_MS) return;
    wifiStage++;
    if (wifiStage >= 2) {
        Serial.println("wifi: both tried; leaving it to autoreconnect");
        return;
    }
    wifiBeginStage();
}

/* ── say hello once ────────────────────────────────────────────────────────
   Everything the board sends lives here and in pbhello.h. Whole block compiles
   out at PB_PHONE_HOME 0. */
#if PB_PHONE_HOME

static char     helloUuid[PB_HELLO_UUID_LEN] = "";
static char     helloBody[PB_HELLO_MAX_PAYLOAD] = "";
static bool     helloDone     = false;   // one attempt per boot, win or lose
static uint32_t helloEarliest = 0;

/* The disclosure, shown once per payload version, BEFORE anything is sent.
   ⚠ BILINGUAL BECAUSE IT IS CONSENT, NOT DECORATION. The game is Portuguese —
   the printed books are Portuguese, so a player necessarily reads it — but the
   person who FLASHES a board is not always the person who plays it, and this
   project is being published to an international audience. A notice in a
   language the reader does not read is not a notice.

   ⚠ PRESENT TENSE, AND IT NAMES THIS VERSION ONLY. An earlier draft promised
   "nunca suas respostas". The planned multiplayer follow-up has a public
   scoreboard, which is answers leaving the device — so that promise would have
   been broken by its own roadmap. pbhello.h re-asks when the payload changes;
   this text simply never claims anything about a build that does not exist yet.

   ⚠ "sem criptografia" is TRUE and must stay true. The POST is plain HTTP: TLS
   costs flash on a partition already near full, and the payload is a random
   number plus a version string. If that ever changes to HTTPS, change this line
   in the same commit. */
static void helloDisclose()
{
    /* ⚠ The strings live in pbhello.h so hello-test/fit.c measures the SAME
       copy the panel draws. Re-typing them here would make that test prove only
       that someone typed them twice — and three of these lines DID clip before
       the measurement existed, including "how to turn it off" in both
       languages. Never inline them. */
    const char *const *page[2] = { PB_HELLO_PT, PB_HELLO_EN };

    for (int p = 0; p < 2; p++) {
        tft.fillScreen(C_BG);
        tft.setTextColor(C_SEL, C_BG);
        centreFit(page[p][0], 4, W - 8, T_MED);
        tft.setTextColor(C_TEXT, C_BG);
        /* 17px pitch, not 20: seven lines have to clear a 135px panel, and
           fit.c asserts the last one ends above it. */
        for (int i = 1; i < PB_HELLO_LINES; i++)
            centreFit(page[p][i], 26 + (i - 1) * 17, W - 8, T_SMALL);

        /* Held for a minimum before OK can skip, so one press cannot dismiss
           both pages — which would mean the English one was never displayed. */
        uint32_t t0 = millis();
        while (millis() - t0 < 5000) {
            soundTick();
            if (millis() - t0 > 1600 && digitalRead(PIN_OK) == LOW) break;
            delay(10);
        }
        while (digitalRead(PIN_OK) == LOW) delay(10);   // wait for release
    }
}

/* ⚠ RUNS ON ITS OWN TASK so loop() is never blocked by the network. HTTPClient
   is synchronous: a DNS lookup against a dead resolver stalls for seconds, and
   doing that inside loop() would freeze the buttons, the sound player and the
   idle timer. "Never blocks gameplay" has to be structural, not a short
   timeout that is usually fine. */
static void helloTask(void *)
{
    HTTPClient http;
    http.setConnectTimeout(4000);
    http.setTimeout(4000);
    http.setReuse(false);

    String url = String("http://") + PB_API_HOST + "/hello";
    if (http.begin(url)) {
        http.addHeader("Content-Type", "application/json");
        int code = http.POST((uint8_t *)helloBody, strlen(helloBody));
        Serial.printf("hello: POST %s -> %d\n", url.c_str(), code);
        http.end();
    } else {
        Serial.println("hello: begin() failed");
    }
    vTaskDelete(NULL);
}

static void helloTick()
{
    /* ⚠ ONE ATTEMPT PER BOOT. helloDone is set BEFORE the attempt, not after,
       so a failure can never re-enter. A board on a captive-portal WiFi would
       otherwise POST every pass of loop() forever — the exact runaway this
       ordering exists to make unrepresentable. */
    if (helloDone) return;
    if (WiFi.status() != WL_CONNECTED) return;
    if (millis() < helloEarliest) return;
    helloDone = true;

    /* ⚠ Generated only now, never in setup(): esp_random() is a true RNG only
       once the RF subsystem is running. Seeded before that it returns a
       pseudo-random sequence identical on every board — which would look
       perfectly valid and silently collapse the count to 1. */
    if (helloUuid[0] == '\0') {
        unsigned char rnd[16];
        for (int i = 0; i < 16; i++) rnd[i] = (unsigned char)(esp_random() & 0xFF);
        pb_hello_uuid4(rnd, helloUuid);
        prefs.putString("hello_id", helloUuid);
        Serial.printf("hello: new board id %s\n", helloUuid);
    }

    if (pb_hello_payload(helloUuid, PB_VERSION, helloBody, sizeof helloBody) == 0) {
        Serial.println("hello: payload would not fit — sending nothing");
        return;
    }
    /* ⚠ 16 KB, not 8: HTTPClient + WiFiClient + the TCP buffers live on THIS
       task's stack, and an overflow is a panic-reboot, not a failed request. */
    xTaskCreate(helloTask, "hello", 16384, NULL, 1, NULL);
}
#endif  /* PB_PHONE_HOME */

void setup()
{
    Serial.begin(115200);

    pinMode(PIN_OK, INPUT_PULLUP);
    pinMode(PIN_SELECT, INPUT);   // ⚠ input-only pin: no internal pull-up exists

    tft.init();
    tft.setRotation(1);
    tft.fillScreen(C_BG);

    // ⚠ AFTER tft.init(): it re-claims its backlight pin as a plain output and
    //   would clobber a PWM mux attached before it.
    ledcAttach(PIN_BL, 5000, 8);
    ledcWrite(PIN_BL, BL_ON);
#if PB_BUZZER_PIN >= 0
    ledcAttach(PB_BUZZER_PIN, 2000, 10);
    ledcWriteTone(PB_BUZZER_PIN, 0);
#endif

    pb_init();

    prefs.begin("pensebem", false);
    muted       = prefs.getBool("muted", false);
    lastScore   = prefs.getInt("score", -1);
    lastBook    = prefs.getInt("book", 0);
    lastSection = prefs.getInt("sec", 0);

#if PB_PHONE_HOME
    /* The id persists across reboots — a board is counted once, not once per
       power cycle. Generated lazily in helloTick(), not here: see the RNG note
       there. */
    prefs.getString("hello_id", helloUuid, sizeof helloUuid);
    if (!pb_hello_valid(helloUuid)) helloUuid[0] = '\0';
#endif

    // WiFi NEVER blocks. The game must work with every AP down.
    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    wifiStage = 0;              // hotspot first, secrets.h as the fallback
    wifiBeginStage();
    MDNS.begin(HOSTNAME);
    ArduinoOTA.setHostname(HOSTNAME);
    ArduinoOTA.setPassword(OTA_PASS);
    ArduinoOTA.onStart([]() { soundStop(); tft.fillScreen(C_BG);
                              medium(); tft.setTextColor(C_SEL, C_BG);
                              centre("ATUALIZANDO", 50); });
    ArduinoOTA.onEnd([]()   { centre("OK", 90); });
    ArduinoOTA.begin();

    // Serial parity dump — diff against the Go backend's
    // GET /api/v1/books/{n}/answers. Two implementations agreeing is a real
    // check; a header agreeing with itself is not.
    Serial.printf("\npense-bem %s  |  offsets popped=%d (must be %d)\n",
                  PB_VERSION, pb_offsets_popped(), PB_OFFSETS);
    for (int b = 1; b <= 99; b += 49) {
        Serial.printf("book %02d: ", b);
        const unsigned char *k = pb_answer_key(b);
        for (int q = 0; q < PB_QUESTIONS; q++) { Serial.write(k[q]); }
        Serial.println();
    }

    /* ⚠ The splash doubles as the buzzer wiring self-test the boot beep used to
       be: four rising notes as the boxes land. Silent board + "SOM LIGADO" on
       standby still means check the wiring. */
    playSplash();

#if PB_PHONE_HOME
    /* ⚠ AFTER the splash and BEFORE anything is sent. Shown once per payload
       version, so a change to what is sent re-opens the question rather than
       inheriting an answer given about a different message. */
    if (pb_hello_needs_disclosure(prefs.getInt("hello_ok", 0))) {
        helloDisclose();
        prefs.putInt("hello_ok", PB_HELLO_PAYLOAD_VERSION);
    }
    /* A short grace period so the first POST does not race WiFi association
       and burn this boot's single attempt on a stack that was not ready. */
    helloEarliest = millis() + 4000;
#endif

    lastInput = millis();
    go(SC_STANDBY);
}

void loop()
{
    ArduinoOTA.handle();
    inputTick();
    timerTick();
    soundTick();
    render();
    wifiTick();    /* retimes a begin(); never scans, never waits */
#if PB_PHONE_HOME
    helloTick();   /* returns immediately after the single attempt is made */
#endif
    delay(10);
}
